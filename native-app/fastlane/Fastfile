default_platform(:ios)

platform :ios do
  private_lane :revoke_orphaned_distribution_certificates do
    require 'spaceship'

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      filepath: ENV.fetch("API_KEY_PATH")
    )
    Spaceship::ConnectAPI.token = token

    certificates = []
    ["DISTRIBUTION", "IOS_DISTRIBUTION"].each do |certificate_type|
      certificates.concat(
        Spaceship::ConnectAPI::Certificate.all(
          filter: { certificateType: certificate_type }
        )
      )
    end
    certificates = certificates.uniq { |certificate| certificate.id }

    if certificates.count >= 2
      UI.important("Distribution certificate limit reached; revoking #{certificates.count} CI-orphaned certificates")
      certificates.each(&:delete!)
    end
  end

  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("API_KEY_PATH"),
      in_house: false
    )
  end

  private_lane :enable_required_capabilities do
    require 'spaceship'

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      filepath: ENV.fetch("API_KEY_PATH")
    )
    Spaceship::ConnectAPI.token = token

    bundle_id = Spaceship::ConnectAPI::BundleId.find("com.warrescue.app")
    UI.user_error!("Bundle ID com.warrescue.app was not found") unless bundle_id

    capability_type = Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH
    capability = bundle_id.get_capabilities.find { |item| item.is_type?(capability_type) }

    unless capability
      bundle_id.create_capability(
        capability_type,
        settings: [{
        key: Spaceship::ConnectAPI::BundleIdCapability::Settings::APPLE_ID_AUTH_APP_CONSENT,
        options: [{
          key: Spaceship::ConnectAPI::BundleIdCapability::Options::PRIMARY_APP_CONSENT
        }]
        }]
      )
    end
    UI.success("Sign in with Apple capability is enabled for com.warrescue.app")
  end

  private_lane :prepare_signing do |options|
    api_key = options.fetch(:api_key)
    keychain_path = ENV.fetch("KEYCHAIN_PATH")
    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")

    revoke_orphaned_distribution_certificates
    enable_required_capabilities

    get_certificates(
      api_key: api_key,
      platform: "ios",
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_password}' '#{keychain_path}'")

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.warrescue.app",
      platform: "ios",
      force: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      path: "ios/WarRescue.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      bundle_identifier: "com.warrescue.app",
      targets: ["WarRescue"]
    )
  end

  private_lane :build_native_app do |options|
    api_key = options.fetch(:api_key)

    build_app(
      workspace: "ios/WarRescue.xcworkspace",
      scheme: "WarRescue",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: ".",
      output_name: "WarRescue.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          "com.warrescue.app" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )
  end

  desc "Build the React Native app and upload it to TestFlight"
  lane :release do
    api_key = connect_api_key
    prepare_signing(api_key: api_key)

    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.warrescue.app",
      version: "1.1.0",
      initial_build_number: 0
    ) + 1

    increment_build_number(
      build_number: next_build,
      xcodeproj: "ios/WarRescue.xcodeproj"
    )

    build_native_app(api_key: api_key)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build the React Native app without uploading"
  lane :build_only do
    api_key = connect_api_key
    prepare_signing(api_key: api_key)
    build_native_app(api_key: api_key)
  end
end
